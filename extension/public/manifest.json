{
  "manifest_version": 3,
  "name": "Bad Faith",
  "version": "0.1.0",
  "description": "Audit news articles for rhetorical techniques and misinformation",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "reset.html"
      ],
      "matches": [
        "https://*.supabase.co/*"
      ]
    }
  ]
}
