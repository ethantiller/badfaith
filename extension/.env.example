# Vite only exposes VITE_-prefixed variables to the bundle. Copy this to .env.
# The Supabase URL and anon key are project identifiers, not secrets: they ship
# inside the extension by design (see docs/architecture.md section 7).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend base URL, including the scheme.
VITE_API_BASE=http://localhost:8000

