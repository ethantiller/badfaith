# Backend Configuration

# Database (PostgreSQL/Supabase) — provide full URL or components
# Option 1: Full async PostgreSQL URL
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Option 2: Separate components
# DATABASE_INSTANCE_STRING=user@host:5432/dbname
# DATABASE_PASS=your-password

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# CORS
EXTENSION_ORIGIN=chrome-extension://*

# Nemotron (NVIDIA)
NVIDIA_API_KEY=your-nvidia-api-key

# Extension API. Must include the scheme — the extension fetches this URL directly.
API_BASE=http://localhost:8000

# The extension bundle is built from this same file. extension/vite.config.ts copies
# SUPABASE_URL, SUPABASE_KEY and API_BASE (and nothing else) into the bundle as
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY and VITE_API_BASE.

